# Скопируй в .env (или задай в окружении MCP-клиента). .env закоммичен в .gitignore.
# Copy to .env (or set in your MCP client env). .env is gitignored.

# --- Яндекс Вики / Yandex Wiki ---
# OAuth-токен с правами wiki:read / wiki:write
WIKI_TOKEN=
# ID организации Яндекс 360 (заголовок X-Org-Id)
WIKI_ORG_ID=

# --- Общее / Common ---
# (опционально) включить только перечисленные модули, через запятую, напр. wiki
# (optional) enable only listed modules, comma-separated, e.g. wiki
# YANDEX360_ENABLE=wiki
